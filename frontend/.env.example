# ---------------------------------------------------------------------------
# Firebase web app configuration.
#
# Firebase console > Project settings > General > Your apps > SDK setup and
# configuration. Copy the six values into this file.
#
# Leave every value empty to run the app in demo mode: authentication and the
# database are then emulated in the browser with localStorage, so the whole UI
# can be explored without a Firebase project.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Backend API of the Codewarden service.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000

# Set to 1 to force demo mode even when the Firebase variables are present.
VITE_DEMO_MODE=0
