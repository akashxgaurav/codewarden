{
  "name": "codewarden2-backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "dist/api/server.js",
  "scripts": {
    "dev": "node --import tsx --watch --watch-path=src src/api/server.ts",
    "dev:cli": "node --import tsx --watch --watch-path=src src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/api/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "secret": "node --import tsx scripts/generate-ingest-secret.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@langchain/core": "^1.3.6",
    "@langchain/groq": "^1.3.1",
    "@langchain/langgraph": "^1.7.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "langchain": "^1.6.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
