# --- HTTP API -------------------------------------------------------------
PORT=3000
CODEWARDEN_API_HOST=0.0.0.0
CODEWARDEN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CODEWARDEN_STRICT_CORS=0
CODEWARDEN_PUBLIC_API_URL=

# --- AI -------------------------------------------------------------------
GROQ_API_KEY=
CODEWARDEN_MODEL=openai/gpt-oss-20b
CODEWARDEN_REASONING_EFFORT=low
CODEWARDEN_TPM_LIMIT=8000

# --- Repository changes ---------------------------------------------------
# 1 = push the fix branch, 0 = keep the fix local
CODEWARDEN_PUSH=0
CODEWARDEN_SKIP_INSTALL=0

# --- GitHub App (private repositories + pull requests) --------------------
# Create an App at https://github.com/settings/apps/new
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_WEBHOOK_SECRET=
# Optional: restrict the install link to one account (e.g. your-org)
GITHUB_APP_INSTALL_ACCOUNT=

# --- ChromaDB knowledge base ----------------------------------------------
CHROMA_ENABLED=1
CHROMA_URL=http://localhost:8000
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_COLLECTION_PREFIX=cw_repo_
CHROMA_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# --- Firebase (optional) ---------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_SERVICE_ACCOUNT_PATH=

# --- CloudWatch ingest -----------------------------------------------------
CODEWARDEN_INGEST_SECRET=
CODEWARDEN_INGEST_DEDUPE_MS=600000

# --- Activity feed ---------------------------------------------------------
# How long activity events stay available to the dashboard (ms)
ACTIVITY_TTL_MS=3600000
ACTIVITY_MAX_EVENTS=1000
